#!/usr/bin/env python3
"""One-time authorization of the Omacord plugin against your Discord app.

Discord's RPC socket hands out nothing until an OAuth2 token backs the
connection, and the token can only be obtained by asking the running Discord
client to show you a consent dialog. That is what this does:

  1. connect to the local Discord socket and shake hands as your app
  2. AUTHORIZE, which pops the "Omacord wants to access your account" dialog
  3. trade the returned code for an access + refresh token
  4. write them to ~/.local/state/omacord/credentials.json (mode 600)

Usage:
  omacord-auth --client-id ID [--client-secret SECRET]
  omacord-auth --status
  omacord-auth --logout
"""

import argparse
import getpass
import json
import os
import socket
import struct
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API_BASE = "https://discord.com/api/v10"
OP_HANDSHAKE = 0
OP_FRAME = 1

SCOPES = ["rpc", "rpc.notifications.read", "rpc.voice.read", "rpc.voice.write"]


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "omacord")


CREDENTIALS_PATH = os.path.join(state_dir(), "credentials.json")


def candidate_sockets():
    bases = [os.environ[key] for key in ("XDG_RUNTIME_DIR", "TMPDIR", "TMP", "TEMP")
             if os.environ.get(key)]
    bases.append("/tmp")
    subdirs = [
        "",
        "app/com.discordapp.Discord",
        "app/com.discordapp.DiscordCanary",
        "app/dev.vencord.Vesktop",
        "app/io.github.spacingbat3.webcord",
        "snap.discord",
        ".flatpak/com.discordapp.Discord/xdg-run",
    ]
    seen = set()
    for base in bases:
        for sub in subdirs:
            directory = os.path.join(base, sub) if sub else base
            for index in range(10):
                path = os.path.join(directory, "discord-ipc-%d" % index)
                if path not in seen:
                    seen.add(path)
                    yield path


def die(message):
    print("omacord-auth: %s" % message, file=sys.stderr)
    sys.exit(1)


class Client:
    def __init__(self, sock):
        self.sock = sock
        self.buffer = b""
        self.nonce = 0

    def send(self, opcode, payload):
        blob = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.sock.sendall(struct.pack("<II", opcode, len(blob)) + blob)

    def command(self, cmd, args):
        self.nonce += 1
        nonce = "omacord-auth-%d" % self.nonce
        self.send(OP_FRAME, {"cmd": cmd, "nonce": nonce, "args": args})
        return nonce

    def read(self, deadline):
        """Next complete frame, or None once `deadline` passes."""
        while True:
            while len(self.buffer) >= 8:
                opcode, length = struct.unpack("<II", self.buffer[:8])
                if len(self.buffer) < 8 + length:
                    break
                body = self.buffer[8:8 + length]
                self.buffer = self.buffer[8 + length:]
                return opcode, json.loads(body.decode("utf-8"))

            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            self.sock.settimeout(min(remaining, 5))
            try:
                chunk = self.sock.recv(65536)
            except socket.timeout:
                continue
            if not chunk:
                die("Discord closed the connection")
            self.buffer += chunk


def connect():
    for path in candidate_sockets():
        if not os.path.exists(path):
            continue
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(path)
        except OSError:
            sock.close()
            continue
        return Client(sock), path
    die("no Discord IPC socket found — is the Discord desktop app running?")


def exchange_code(client_id, client_secret, code, redirect_uri):
    body = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
    }).encode()
    request = urllib.request.Request(
        API_BASE + "/oauth2/token",
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            # Cloudflare in front of discord.com rejects the default urllib
            # signature with a 403 (error 1010); any honest UA passes.
            "User-Agent": "omacord (https://github.com/EmanueleValentini/omacord, 0.1.0)",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")
        hint = ("The redirect URI must match one registered on the app "
                "(OAuth2 → Redirects).")
        if "error code: 10" in detail:
            hint = ("Blocked by Cloudflare before reaching Discord — "
                    "check the User-Agent this script sends.")
        die("token exchange rejected (%s): %s\n%s" % (error.code, detail, hint))
    except (urllib.error.URLError, OSError) as error:
        die("token exchange failed: %s" % error)


def save(credentials):
    os.makedirs(state_dir(), mode=0o700, exist_ok=True)
    temporary = CREDENTIALS_PATH + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(credentials, handle, indent=2)
    os.chmod(temporary, 0o600)
    os.replace(temporary, CREDENTIALS_PATH)


def show_status():
    try:
        with open(CREDENTIALS_PATH, "r", encoding="utf-8") as handle:
            credentials = json.load(handle)
    except FileNotFoundError:
        print("not authorized — run: omacord-auth --client-id <ID>")
        return 1
    except (OSError, ValueError) as error:
        die("credentials unreadable: %s" % error)

    expires_at = float(credentials.get("expires_at") or 0)
    remaining = expires_at - time.time()
    print("credentials: %s" % CREDENTIALS_PATH)
    print("client id:   %s" % credentials.get("client_id", "?"))
    print("user:        %s" % credentials.get("user", "?"))
    print("scopes:      %s" % " ".join(credentials.get("scopes", [])))
    if remaining > 0:
        print("token:       valid for %d days" % (remaining / 86400))
    else:
        print("token:       expired — the plugin refreshes it on next connect")
    return 0


def authorize(args):
    client_id = args.client_id or os.environ.get("OMACORD_CLIENT_ID") or ""
    if not client_id:
        client_id = input("Discord application client ID: ").strip()
    if not client_id.isdigit():
        die("client id must be the numeric application ID from the Developer Portal")

    client_secret = args.client_secret or os.environ.get("OMACORD_CLIENT_SECRET") or ""
    if not client_secret:
        client_secret = getpass.getpass("Client secret (OAuth2 page, hidden): ").strip()
    if not client_secret:
        die("a client secret is required to exchange the authorization code")

    client, path = connect()
    print("connected to %s" % path)
    client.send(OP_HANDSHAKE, {"v": 1, "client_id": client_id})

    deadline = time.monotonic() + 30
    while True:
        frame = client.read(deadline)
        if frame is None:
            die("Discord never sent READY — check the client ID")
        payload = frame[1]
        if payload.get("evt") == "READY":
            break
        if payload.get("evt") == "ERROR":
            die((payload.get("data") or {}).get("message", "handshake refused"))

    client.command("AUTHORIZE", {"client_id": client_id, "scopes": SCOPES})
    print("Approve the request in the Discord window (waiting up to 3 minutes)...")

    deadline = time.monotonic() + 180
    code = ""
    while True:
        frame = client.read(deadline)
        if frame is None:
            die("timed out waiting for approval")
        payload = frame[1]
        if payload.get("cmd") != "AUTHORIZE":
            continue
        if payload.get("evt") == "ERROR":
            data = payload.get("data") or {}
            die("authorization refused: %s (code %s)"
                % (data.get("message", "unknown"), data.get("code", "?")))
        code = (payload.get("data") or {}).get("code", "")
        break

    if not code:
        die("Discord returned no authorization code")

    token = exchange_code(client_id, client_secret, code, args.redirect_uri)
    credentials = {
        "client_id": client_id,
        "client_secret": client_secret,
        "access_token": token.get("access_token", ""),
        "refresh_token": token.get("refresh_token", ""),
        "expires_at": time.time() + float(token.get("expires_in", 0) or 0),
        "scopes": (token.get("scope", "") or " ".join(SCOPES)).split(),
        "redirect_uri": args.redirect_uri,
    }
    save(credentials)
    print("saved %s" % CREDENTIALS_PATH)
    print("restart the shell to pick it up:  omarchy restart shell")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="omacord-auth",
        description="Authorize the Omacord bar plugin against your Discord application.")
    parser.add_argument("--client-id", help="application ID from the Discord Developer Portal")
    parser.add_argument("--client-secret", help="OAuth2 client secret (prompted when omitted)")
    parser.add_argument("--redirect-uri", default="http://localhost",
                        help="redirect URI registered on the app (default: http://localhost)")
    parser.add_argument("--status", action="store_true", help="show stored credentials")
    parser.add_argument("--logout", action="store_true", help="delete stored credentials")
    args = parser.parse_args()

    if args.status:
        return show_status()
    if args.logout:
        try:
            os.remove(CREDENTIALS_PATH)
            print("removed %s" % CREDENTIALS_PATH)
        except FileNotFoundError:
            print("nothing to remove")
        return 0
    return authorize(args)


if __name__ == "__main__":
    sys.exit(main())
